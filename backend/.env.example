# Database (MySQL in production)
DATABASE_URL=mysql+pymysql://smp:smp_password@localhost:3306/smp?charset=utf8mb4

# Security — generate real values:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"            -> JWT_SECRET
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())" -> VAULT_KEY
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=480
VAULT_KEY=

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:5173

# Email (leave SMTP_HOST empty to print emails/OTPs to the console in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=smp@example.com
SMTP_TLS=true

APP_TIMEZONE=Asia/Dhaka
ENVIRONMENT=development
